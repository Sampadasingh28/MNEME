# MNEME Environment Configuration
PORT=5000
NODE_ENV=development

# Optional server-side voice provider integration (provider-independent)
# Leave blank to use browser speech capabilities where available and text fallback everywhere.
# MNEME does not assume any provider supports every language. Keep API keys on the server only.
VOICE_PROVIDER_NAME=
VOICE_STT_URL=
VOICE_STT_API_KEY=
VOICE_TTS_URL=
VOICE_TTS_API_KEY=

# Optional database/auth configuration (only if you connect external services)
SUPABASE_URL=
SUPABASE_ANON_KEY=
